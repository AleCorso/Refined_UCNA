 " which can be solved by integrating twice:"
}], "Text",
 CellChangeTimes->{{3.964684343178763*^9, 3.964684359971692*^9}, {
  3.974346169079516*^9, 
  3.974346170628643*^9}},ExpressionUUID->"4865d2ef-27e4-405c-8d99-\
4d9035dbd37e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Psi]1", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Integrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Nu]", " ", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"\[Psi]0", " ", "ps"}], ",", "x"}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"f", "[", "x", "]"}], " ", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"\[Psi]0", " ", "ps"}], ",", "\[Nu]"}], "]"}]}]}], ",", 
          
          RowBox[{"{", 
           RowBox[{"\[Nu]", ",", 
            RowBox[{"-", "Infinity"}], ",", "\[Nu]"}], "}"}]}], "]"}], "/", 
        "d"}], "/", "ps"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Nu]", ",", "0", ",", "\[Nu]"}], "}"}]}], "]"}], "+", 
    RowBox[{"\[Phi]1", "[", 
     RowBox[{"x", ",", "\[Theta]"}], "]"}]}], "//", "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.954380605815043*^9, 3.954380627520134*^9}, {
  3.9932097687302322`*^9, 3.9932097913771143`*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"67bbfa17-01eb-4378-aeaa-1995713c0afd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"\[Nu]", " ", 
     RowBox[{"f", "(", "x", ")"}], " ", 
     RowBox[{"\[Phi]0", "(", 
      RowBox[{"x", ",", "\[Theta]"}], ")"}]}], "d"], "+", 
   FractionBox[
    RowBox[{"\[Nu]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         SuperscriptBox["\[CapitalGamma]", "\[Prime]",
          MultilineFunction->None], "(", "x", ")"}], " ", 
        RowBox[{"\[Phi]0", "(", 
         RowBox[{"x", ",", "\[Theta]"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"6", " ", "d"}], "+", 
          RowBox[{
           SuperscriptBox["\[Nu]", "2"], " ", 
           RowBox[{"\[CapitalGamma]", "(", "x", ")"}]}]}], ")"}]}], "-", 
       RowBox[{"6", " ", "d", " ", 
        RowBox[{"\[CapitalGamma]", "(", "x", ")"}], " ", 
        RowBox[{
         SuperscriptBox["\[Phi]0", 
          TagBox[
           RowBox[{"(", 
            RowBox[{"1", ",", "0"}], ")"}],
           Derivative],
          MultilineFunction->None], "(", 
         RowBox[{"x", ",", "\[Theta]"}], ")"}]}]}], ")"}]}], 
    RowBox[{"6", " ", "d", " ", 
     SuperscriptBox[
      RowBox[{"\[CapitalGamma]", "(", "x", ")"}], "2"]}]], "+", 
   RowBox[{"\[Phi]1", "(", 
    RowBox[{"x", ",", "\[Theta]"}], ")"}]}], TraditionalForm]], "Output",
 CellChangeTimes->{3.954380635349207*^9, 3.954393008564127*^9, 
  3.955532124598198*^9, 3.961648529094502*^9, 3.965968503525955*^9, 
  3.974346175196297*^9, 3.974368347473112*^9, 3.974368656360935*^9, 
  3.974368800708961*^9, 3.974369226861448*^9, 3.993209803103891*^9},
 CellLabel->"Out[13]=",ExpressionUUID->"9a63bb32-15dc-4e90-b0a7-2b0a28f2d9e4"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"p1", "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[Psi]1", " ", "ps"}], ")"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Nu]", ",", 
      RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}]}], "]"}]}]], "Input",\

 CellChangeTimes->{{3.9533792162554693`*^9, 3.953379229591352*^9}, {
  3.953390131982565*^9, 3.95339014211675*^9}, {3.9533921005722017`*^9, 
  3.953392100951954*^9}, {3.9932098087242813`*^9, 3.9932098095020447`*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"77a55dfa-11fa-4038-a730-29a0effc720c"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{"\[Phi]1", "(", 
    RowBox[{"x", ",", "\[Theta]"}], ")"}], 
   SqrtBox[
    RowBox[{"\[CapitalGamma]", "(", "x", ")"}]]], TraditionalForm]], "Output",\

 CellChangeTimes->{
  3.953379232793452*^9, 3.953389710241091*^9, 3.953390151171986*^9, {
   3.953392082404751*^9, 3.953392103972372*^9}, 3.954380554899472*^9, 
   3.954380655942502*^9, 3.954393010659437*^9, 3.95553212667668*^9, 
   3.961648531432302*^9, 3.965968505632956*^9, 3.9743461776581373`*^9, 
   3.974368664323982*^9, 3.974368804866167*^9, 3.974369229370842*^9, {
   3.993209806557637*^9, 3.993209813107267*^9}},
 CellLabel->"Out[15]=",ExpressionUUID->"981f3b54-c715-4dc9-8700-6b48ce797c0e"]
}, Open  ]]
}, Open  ]],

