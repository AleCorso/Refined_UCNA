db5a53afbb99"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"soldtphi0", "=", 
  RowBox[{
   RowBox[{"Rule", "[", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"\[Phi]0", "[", 
        RowBox[{"x", ",", "\[Theta]"}], "]"}], ",", "\[Theta]"}], "]"}], ",", 
     
     RowBox[{
      RowBox[{"-", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Integrate", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"ps", " ", "\[Nu]", " ", "\[Psi]1"}], ")"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Nu]", ",", 
             RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}]}], "]"}], 
         ",", "x"}], "]"}]}], "/", "normps"}]}], "]"}], "//", 
   "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.953389964052346*^9, 3.9533901110918007`*^9}, {
  3.953390169977585*^9, 3.953390197167894*^9}, {3.953390356816358*^9, 
  3.95339040938058*^9}, {3.953391999013747*^9, 3.953391999334559*^9}, {
  3.954382220627963*^9, 3.954382221499557*^9}, {3.993209818972784*^9, 
  3.993209838358245*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"3eaf88e4-8133-4bfc-9c60-9e7250134fe8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[Phi]0", 
     TagBox[
      RowBox[{"(", 
       RowBox[{"0", ",", "1"}], ")"}],
      Derivative],
     MultilineFunction->None], "(", 
    RowBox[{"x", ",", "\[Theta]"}], ")"}], "\[Rule]", 
   FractionBox[
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"\[CapitalGamma]", "(", "x", ")"}], "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"4", " ", "d", " ", 
         RowBox[{
          SuperscriptBox["\[Phi]0", 
           TagBox[
            RowBox[{"(", 
             RowBox[{"2", ",", "0"}], ")"}],
            Derivative],
           MultilineFunction->None], "(", 
          RowBox[{"x", ",", "\[Theta]"}], ")"}]}], "+", 
        RowBox[{"6", " ", 
         RowBox[{"f", "(", "x", ")"}], " ", 
         RowBox[{
          SuperscriptBox["\[CapitalGamma]", "\[Prime]",
           MultilineFunction->None], "(", "x", ")"}], " ", 
         RowBox[{"\[Phi]0", "(", 
          RowBox[{"x", ",", "\[Theta]"}], ")"}]}]}], ")"}]}], "+", 
     RowBox[{"21", " ", "d", " ", 
      SuperscriptBox[
       RowBox[{
        SuperscriptBox["\[CapitalGamma]", "\[Prime]",
         MultilineFunction->None], "(", "x", ")"}], "2"], " ", 
      RowBox[{"\[Phi]0", "(", 
       RowBox[{"x", ",", "\[Theta]"}], ")"}]}], "-", 
     RowBox[{"2", " ", "d", " ", 
      RowBox[{"\[CapitalGamma]", "(", "x", ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", " ", 
         RowBox[{
          SuperscriptBox["\[CapitalGamma]", "\[Prime]\[Prime]",
           MultilineFunction->None], "(", "x", ")"}], " ", 
         RowBox[{"\[Phi]0", "(", 
          RowBox[{"x", ",", "\[Theta]"}], ")"}]}], "+", 
        RowBox[{"8", " ", 
         RowBox[{
          SuperscriptBox["\[CapitalGamma]", "\[Prime]",
           MultilineFunction->None], "(", "x", ")"}], " ", 
         RowBox[{
          SuperscriptBox["\[Phi]0", 
           TagBox[
            RowBox[{"(", 
             RowBox[{"1", ",", "0"}], ")"}],
            Derivative],
           MultilineFunction->None], "(", 
          RowBox[{"x", ",", "\[Theta]"}], ")"}]}]}], ")"}]}], "-", 
     RowBox[{"4", " ", 
      SuperscriptBox[
       RowBox[{"\[CapitalGamma]", "(", "x", ")"}], "3"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{
          SuperscriptBox["f", "\[Prime]",
           MultilineFunction->None], "(", "x", ")"}], " ", 
         RowBox[{"\[Phi]0", "(", 
          RowBox[{"x", ",", "\[Theta]"}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"f", "(", "x", ")"}], " ", 
         RowBox[{
          SuperscriptBox["\[Phi]0", 
           TagBox[
            RowBox[{"(", 
             RowBox[{"1", ",", "0"}], ")"}],
            Derivative],
           MultilineFunction->None], "(", 
          RowBox[{"x", ",", "\[Theta]"}], ")"}]}]}], ")"}]}]}], 
    RowBox[{"4", " ", 
     SuperscriptBox[
      RowBox[{"\[CapitalGamma]", "(", "x", ")"}], "4"]}]]}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{
  3.953390086923181*^9, 3.953390159143715*^9, {3.95339018923888*^9, 
   3.953390199947781*^9}, {3.953390369171172*^9, 3.953390410315249*^9}, 
   3.953392019507888*^9, 3.954381179019629*^9, 3.954382278655763*^9, 
   3.954393014642837*^9, 3.955532130438155*^9, 3.961648535704148*^9, 
   3.9616490135350924`*^9, 3.965968509475825*^9, 3.974346181712886*^9, 
   3.97436867137291*^9, 3.97436881026806*^9, 3.97436923355971*^9, 
   3.993209842851067*^9},
 CellLabel->"Out[16]=",ExpressionUUID->"02e7a371-36c6-4a4b-ba5c-a4d1d4fd4ccf"]
}, Open  ]],

Cell["This set of rules is useful for the following calculations", "Text",
 CellChangeTimes->{{3.964684596507406*^9, 
  3.96468461503534*^9}},ExpressionUUID->"30871ca2-f1d4-4489-a2dc-\
310b2538de7a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rules0", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Rule", "[", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"\[Phi]0", "[", 
            RowBox[{"x", ",", "\[Theta]"}], "]"}], ",", "\[Theta]"}], "]"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "n"}], "}"}]}], "]"}], ",", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"\[Phi]0", "[", 
             RowBox[{"x", ",", "\[Theta]"}], "]"}], ",", "\[Theta]"}], "]"}], 
          "/.", "soldtphi0"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "n"}], "}"}]}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "3"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.954383433475247*^9, 3.954383559239855*^9}, {
  3.954383607687937*^9, 3.95438361566882*^9}, {3.954383646118371*^9, 
