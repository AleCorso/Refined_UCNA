Notebook[{

Cell[CellGroupData[{
Cell["Refined UCNA - Time-scale separation procedure ", "Section",
 CellChangeTimes->{{3.993208428439487*^9, 3.993208473896956*^9}, 
   3.993208506152103*^9},ExpressionUUID->"19fab763-1a11-41c0-86d3-\
c2046a87e2a6"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["This notebook implements the time-scale separation \
procedure to derive the UCNA  (as the equation for the dynamics at zeroth \
order in the expansion parameter \[Epsilon]). The algorithmic procedure can \
be carried out to higher orders, to find (1) that the UCNA still holds even \
considering correction of order \[Epsilon]  to the dynamics and (2) the first \
relevant correction to the UCNA dynamics, at the next order.      ", \
"Text"]], "Subsubsection",
 CellChangeTimes->{{3.993208467380066*^9, 3.993208530696398*^9}, {
  3.993208608716507*^9, 
  3.9932088431968107`*^9}},ExpressionUUID->"b7c9d640-9cc6-477f-9a53-\
9e7e9e6494e0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$PrePrint", "=", "TraditionalForm"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"d", ">", "0"}], ",", 
     RowBox[{
      RowBox[{"\[CapitalGamma]", "[", "x", "]"}], ">", "0"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.96982047026672*^9, 3.969820479805017*^9}, {
  3.993208412265863*^9, 3.993208412807857*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"4a9f7805-423f-4f10-a1bf-d3dac4404d47"],

