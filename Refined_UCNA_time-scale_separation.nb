Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]0", "=", 
   RowBox[{"\[Phi]0", "[", 
    RowBox[{"x", ",", "\[Theta]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9543804726059093`*^9, 3.954380495742207*^9}, {
  3.993209470309865*^9, 3.9932094731587677`*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"2c2ac668-e2e7-43c1-ac04-c5adc9e61a01"],

Cell["\<\
After integrating out \[Nu] the link between \[Phi]0 and the zeroth order \
marginal p(x,\[Theta]) is\
\>", "Text",
 CellChangeTimes->{{3.993209389895554*^9, 3.99320942501132*^9}, {
  3.993209486078644*^9, 
  3.993209571788217*^9}},ExpressionUUID->"ff233964-65bd-43df-bd23-\
53da9771e841"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"p0", "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"\[Psi]0", " ", "ps"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Nu]", ",", 
      RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}]}], "]"}]}]], "Input",\

 CellChangeTimes->{{3.95337902617209*^9, 3.953379059202859*^9}, {
  3.953390113316875*^9, 3.953390116146804*^9}, {3.953392094892803*^9, 
  3.95339209813588*^9}, {3.954380545105022*^9, 3.95438055049165*^9}, {
  3.993209619213396*^9, 3.993209620646599*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"1f00e898-3b81-4920-b6ad-999677e3957a"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{"\[Phi]0", "(", 
    RowBox[{"x", ",", "\[Theta]"}], ")"}], 
   SqrtBox[
    RowBox[{"\[CapitalGamma]", "(", "x", ")"}]]], TraditionalForm]], "Output",\

 CellChangeTimes->{{3.953379066545444*^9, 3.9533790896607113`*^9}, 
   3.953379143826661*^9, 3.953389710012618*^9, 3.95339015681263*^9, 
   3.95339210556698*^9, 3.9543805528225174`*^9, {3.954380652782607*^9, 
   3.95438066990469*^9}, 3.95439300290746*^9, 3.955532119990694*^9, 
   3.961648523015245*^9, 3.965968497798151*^9, 3.9743461664761333`*^9, 
   3.9743685693826447`*^9, 3.974368611013071*^9, 3.97436922053909*^9, {
   3.993209611113935*^9, 3.993209621704554*^9}},
 CellLabel->"Out[10]=",ExpressionUUID->"86341f1f-315c-4f59-92e3-438ea051daec"]
}, Open  ]],

Cell["We also define for utility the norm of ps:", "Text",
 CellChangeTimes->{{3.993209638144442*^9, 
  3.993209661130381*^9}},ExpressionUUID->"9a3d3c2b-f41a-4233-a262-\
1a5406569d96"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"normps", " ", "=", " ", 
  RowBox[{"Integrate", "[", 
   RowBox[{"ps", ",", 
    RowBox[{"{", 
     RowBox[{"\[Nu]", ",", 
      RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}]}], "]"}]}]], "Input",\

 CellChangeTimes->{{3.9543821943528748`*^9, 3.954382211461422*^9}, {
  3.99320962720884*^9, 3.993209628735189*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"b3f0bb2f-9e2b-4c1b-8349-d27c437c702e"],

Cell[BoxData[
 FormBox[
  FractionBox["1", 
   SqrtBox[
    RowBox[{"\[CapitalGamma]", "(", "x", ")"}]]], TraditionalForm]], "Output",\

 CellChangeTimes->{
  3.954382212779578*^9, 3.954393004102352*^9, 3.955532120664131*^9, 
   3.961648523939286*^9, 3.965968499119274*^9, 3.974346167500292*^9, 
   3.974368335768792*^9, 3.974368612129731*^9, 3.974368790159808*^9, 
   3.9743692217593403`*^9, {3.993209625237959*^9, 3.993209630874579*^9}},
 CellLabel->"Out[12]=",ExpressionUUID->"1d0a05ba-c9eb-4e15-8055-5ef8ad44f16e"]
}, Open  ]]
}, Open  ]],

