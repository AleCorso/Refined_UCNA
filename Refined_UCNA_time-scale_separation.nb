  3.993209367027768*^9}},ExpressionUUID->"119081e6-a42e-45d7-98f1-\
69457eacb41d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ps", "=", 
  RowBox[{
   RowBox[{"E", "^", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"\[Nu]", "^", "2"}]}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalGamma]", "[", "x", "]"}], "/", "2"}], "/", "d"}]}], 
     ")"}]}], "/", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"2", " ", "Pi", " ", "d"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.953379108401271*^9, 3.953379116177997*^9}, 
   3.953392459297866*^9, 3.993208992461225*^9, {3.993209452580183*^9, 
   3.993209454777504*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"30890f7d-5236-42de-bf3f-73e48d7b0886"],

Cell[BoxData[
 FormBox[
  FractionBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[Nu]", "2"], " ", 
       RowBox[{"\[CapitalGamma]", "(", "x", ")"}]}], 
      RowBox[{"2", " ", "d"}]]}]], 
   RowBox[{
    SqrtBox[
     RowBox[{"2", " ", "\[Pi]"}]], " ", 
    SqrtBox["d"]}]], TraditionalForm]], "Output",
 CellChangeTimes->{3.9932089928465357`*^9, 3.993209466129388*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"b007c38d-82c1-40eb-8e05-2febe10e6f78"]
}, Open  ]],

